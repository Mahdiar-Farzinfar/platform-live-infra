# ==============================================================================
# .gitattributes — platform-live-infra
# ------------------------------------------------------------------------------
# Goals:
#   1. Deterministic, cross-platform line endings (LF everywhere except the
#      handful of formats that REQUIRE CRLF on Windows).
#   2. Correct binary handling (no accidental EOL/whitespace mangling).
#   3. Cleaner diffs and language-aware tooling.
#   4. Slimmer `git archive` / release tarballs via export-ignore.
#   5. Accurate GitHub Linguist language statistics.
#
# Rule precedence: later matching lines win. Keep the broad default first,
# then progressively more specific overrides below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Global default
# ------------------------------------------------------------------------------
# Normalize all text on commit to LF in the repo; check out with the platform's
# native convention only where we don't override it explicitly below.
*                       text=auto

# ==============================================================================
# 1. Source & config — force LF
# ------------------------------------------------------------------------------
# These MUST be LF regardless of OS. A CRLF-corrupted shebang script or HCL file
# is a classic cross-platform CI failure.
# ==============================================================================

# --- Infrastructure as Code -------------------------------------------------
*.tf                    text eol=lf
*.tfvars                text eol=lf
*.hcl                   text eol=lf
*.tofu                  text eol=lf
*.tftpl                 text eol=lf linguist-language=HCL

# Terraform/OpenTofu lockfile: generated, keep LF, hide from diffs & linguist.
.terraform.lock.hcl     text eol=lf -diff linguist-generated=true

# --- Shell / POSIX scripts --------------------------------------------------
*.sh                    text eol=lf
*.bash                  text eol=lf
# Extensionless files inside bootstrap/ are typically POSIX shell — leave to
# `text=auto`; add explicit rules if you introduce extensionless executables.

# --- Python -----------------------------------------------------------------
*.py                    text eol=lf
*.pyi                   text eol=lf
*.pyx                   text eol=lf

# --- Go ---------------------------------------------------------------------
*.go                    text eol=lf
go.mod                  text eol=lf
go.sum                  text eol=lf -diff linguist-generated=true

# --- Data / config ----------------------------------------------------------
*.json                  text eol=lf
*.jsonc                 text eol=lf
*.yaml                  text eol=lf
*.yml                   text eol=lf
*.toml                  text eol=lf
*.ini                   text eol=lf
*.cfg                   text eol=lf
*.env                   text eol=lf
*.tool-versions         text eol=lf

# --- Docs / markup ----------------------------------------------------------
*.md                    text eol=lf
*.markdown              text eol=lf
*.rst                   text eol=lf
*.txt                   text eol=lf
*.css                   text eol=lf
*.html                  text eol=lf

# --- Build / task runners & container -------------------------------------
Makefile                text eol=lf
*.mk                    text eol=lf
Taskfile.yml            text eol=lf
justfile                text eol=lf
Dockerfile              text eol=lf
*.dockerfile            text eol=lf
.dockerignore           text eol=lf

# --- Dotfiles & repo metadata ----------------------------------------------
.gitattributes          text eol=lf
.gitignore              text eol=lf
.editorconfig           text eol=lf
.terraformignore        text eol=lf
.trivyignore            text eol=lf
CODEOWNERS              text eol=lf

# ==============================================================================
# 2. Windows-native scripts — force CRLF
# ------------------------------------------------------------------------------
# PowerShell and legacy Windows batch tooling expect/behave best with CRLF.
# ==============================================================================
*.ps1                   text eol=crlf
*.psm1                  text eol=crlf
*.psd1                  text eol=crlf
*.bat                   text eol=crlf
*.cmd                   text eol=crlf

# ==============================================================================
# 3. Binary assets — never touch EOL, never diff as text
# ==============================================================================
# Images
*.png                   binary
*.jpg                   binary
*.jpeg                  binary
*.gif                   binary
*.ico                   binary
*.webp                  binary
# Diagrams / docs deliverables
*.pdf                   binary
*.drawio                binary
# Archives
*.zip                   binary
*.gz                    binary
*.tar                   binary
*.tgz                   binary
*.bz2                   binary
*.xz                    binary
*.7z                    binary
# Fonts
*.woff                  binary
*.woff2                 binary
*.ttf                   binary
*.eot                   binary
# Certs / keys / signing artifacts (opaque, treat as b    binary
# Compiled Go           binary
*.der                   binary
*.gpg                   binary
*.sig                   binary
# Compiled Go binaries (if ever committed intentionally)
*.exe                   binary

# ==============================================================================
# 4. Diff & merge tuning
# ==============================================================================
# Language-aware diff hunk headers where Git supports them.
*.go                    diff=golang
*.py                    diff=python
*.md                    diff=markdown
*.css                   diff=css
*.html                  diff=html

# Lockfiles / generated artifacts: skip textual diffs (still versioned).
go.sum                  -diff
.terraform.lock.hcl     -diff

# Secrets-adjacent files: never show content in diffs (defense-in-depth; these
# should not be committed at all — see .gitignore).
*.pem                   -diff
*.key                   -diff

# ==============================================================================
# 5. Release hygiene — export-ignore
# ------------------------------------------------------------------------------
# Excluded from `git archive` output (source tarballs / release assets). Keeps
# releases focused on deployable content, not dev/CI scaffolding.
# ==============================================================================
.gitattributes          export-ignore
.gitignore              export-ignore
.editorconfig           export-ignore
.gitattributes          export-ignore
.github/                export-ignore
.devcontainer/          export-ignore
.vscode/                export-ignore
.pre-commit-config.yaml export-ignore
tests/                  export-ignore
docs/                   export-ignore
mkdocs.yml              export-ignore
CONTRIBUTING.md         export-ignore
CODE_OF_CONDUCT.md      export-ignore
.terraformignore        export-ignore

# ==============================================================================
# 6. GitHub Linguist — accurate language stats
# ------------------------------------------------------------------------------
# Ensure the repo reads as an infrastructure project (HCL) rather than being
# skewed by docs, generated files, or vendored content.
# ==============================================================================
*.hcl                   linguist-language=HCL
*.tf                    linguist-language=HCL
*.tftpl                 linguist-language=HCL

# Documentation & vendored/generated content should not count toward stats.
docs/**                 linguist-documentation=true
*.md                    linguist-documentation=true
go.sum                  linguist-generated=true
.terraform.lock.hcl     linguist-generated=true

# Vendored third-party trees (if a Go vendor/ dir is ever added).
vendor/**               linguist-vendored=true
